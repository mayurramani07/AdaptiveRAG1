# Copy to .env and fill in. All values here can point at either a remote
# free-tier hosted instance or a local Docker instance - no code change needed.

APP_ENV=development

# OpenSearch (Dense + BM25). Default: free-tier hosted sandbox (e.g. Bonsai.io).
OPENSEARCH_URL=https://your-opensearch-endpoint:9200
OPENSEARCH_USER=
OPENSEARCH_PASSWORD=

# Neo4j (Graph). Default: AuraDB free tier.
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# Redis (Cache). Default: Upstash free tier.
REDIS_URL=redis://default:password@your-upstash-endpoint:6379

# Generation
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Ingress
API_KEY=changeme
RATE_LIMIT_PER_MINUTE=60

# Cache
CACHE_TTL_SECONDS=86400
# Set to a provider name (e.g. "openai") to enable semantic (embedding) cache lookups.
# Leave empty to run exact-match cache only.
EMBEDDING_PROVIDER=
